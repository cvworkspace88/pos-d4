{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "concurrently -k -n nest,trpc -c blue,magenta \"nest start --watch\" \"nestjs-trpc watch -o ../../packages/api-contract/src\"",
    "start": "node dist/main",
    "trpc:generate": "nestjs-trpc generate -o ../../packages/api-contract/src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test src/auth/refresh-window.test.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "11.2.3",
    "@repo/api-contract": "workspace:*",
    "@trpc/server": "11.18.0",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "nestjs-trpc": "2.13.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@repo/eslint-config": "workspace:*",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "typescript": "5.9.3"
  }
}
