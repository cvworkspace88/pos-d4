{
  // Brings `drizzle/` under `check-types`, which the main project cannot do: its `rootDir` is
  // `./src`, so including the seeds there breaks `nest build`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "noEmit": true
  },
  "include": ["drizzle/**/*.ts", "src/**/*"],
  // `__*.ts` are exempt, deliberately: they are top-level-await scripts, which NodeNext resolves as
  // CommonJS here and rejects. They hold wiring and prompts only; the logic they call is checked.
  "exclude": ["node_modules", "dist", "drizzle/seed/__*.ts"]
}
