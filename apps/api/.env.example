# Which capabilities this process exposes. Independent of DATABASE_URL, which only
# decides *where* the data lives — this decides *what the process can do*.
#
#   cloud - hosted server. Backoffice routers + sync receiver. No printers, no sync client.
#   local - cashier PC, spawned by Electron. POS routers, printers, cash drawer, sync client.
#           Server-owned tables (menu, prices, users, printer config) have NO mutation routers
#           here on purpose: a local write to them would never sync up and the next pull would
#           silently overwrite it. Absence of the module is the enforcement.
#   all   - `trpc:generate` only, so @repo/api-contract carries every router for every client.
#           Never run a server with this.
DEPLOYMENT=cloud

# In dev both clusters come from the root docker-compose.yml — `cloud` on 5432, `local` on 5434.
# Run the API twice, one against each, to exercise sync over real HTTP between two real databases.
#   cloud: postgresql://postgres:postgres@localhost:5432/pos_d4
#   local: postgresql://postgres:postgres@localhost:5434/pos_d4_local
# In production, cloud points at the managed instance and local at whatever the outlet runs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_d4

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PORT=3333
