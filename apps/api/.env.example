# Which routers this process mounts. Required — the
# server refuses to boot without it. Independent of DATABASE_URL, which only decides *where* the
# data lives — this decides *what the process can do*.
#
#   cloud - hosted server for the backoffice: auth, outlets, roles, catalogue, settings, audit.
#   local - outlet hub spawned by Electron, what mobile and desktop talk to: the same minus audit,
#           plus floor (tables, reservations) and sync. The desktop is local-first, so
#           catalogue, staff and settings mutations exist here too.
#   all   - every router. `trpc:generate` reads the source statically and needs no mode; a server
#           started with `all` refuses to boot.
DEPLOYMENT=cloud

# In dev both clusters come from the root docker-compose.yml — `cloud` on 5432, `local` on 5434.
# Run the API twice, one against each, to exercise sync over real HTTP between two real databases.
#   cloud: postgresql://postgres:postgres@localhost:5432/pos_d4
#   local: postgresql://postgres:postgres@localhost:5434/pos_d4_local
# In production, cloud points at the managed instance and local at whatever the outlet runs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_d4

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PORT=3333
