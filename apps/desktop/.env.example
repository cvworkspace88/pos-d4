# Copy to .env. Defaults to http://localhost:3333 if unset (src/renderer/src/trpc.ts).
#
# Inlined into the renderer bundle at build time by Vite, so it is public —
# never put a secret behind a VITE_ prefix.
#
# Changing the host also requires updating connect-src in src/renderer/index.html,
# or the CSP will block every request to the new origin.
VITE_API_URL=http://localhost:3333

# without backoffice, set this to true, allow all backoffice features on dashboard.
VITE_ADMIN_DASHBOARD_ENABLED=true