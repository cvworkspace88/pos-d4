# Copy to .env. Defaults to http://localhost:3333 if unset (app/trpc.ts).
#
# Inlined into the bundle at build time by Vite, so it is public —
# never put a secret behind a VITE_ prefix.
VITE_API_URL=http://localhost:3333

VITE_SENTRY_DSN=

# Source-map upload, build time only — no VITE_ prefix, the token must never reach the bundle.
# All three or none: without SENTRY_AUTH_TOKEN the Sentry vite plugin and the buildEnd hook both
# stay off and the build emits no maps. Token: Sentry > Settings > Auth Tokens, scope
# project:releases (+ project:read). Org and project are the slugs in your Sentry URL.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
