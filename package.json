{
  "name": "pos-d4",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "api:dev": "turbo run dev --filter=@repo/api",
    "api:build": "turbo run build --filter=@repo/api",
    "api:start": "pnpm --filter @repo/api start",
    "api:test": "turbo run test --filter=@repo/api",
    "desktop:dev": "turbo run dev --filter=@repo/desktop",
    "desktop:build": "turbo run build --filter=@repo/desktop",
    "desktop:preview": "pnpm --filter @repo/desktop preview",
    "desktop:package": "pnpm --filter @repo/desktop package",
    "backoffice:dev": "turbo run dev --filter=@repo/backoffice",
    "backoffice:build": "turbo run build --filter=@repo/backoffice",
    "mobile:dev": "turbo run dev --filter=@repo/mobile",
    "mobile:ios": "pnpm --filter @repo/mobile ios",
    "mobile:android": "pnpm --filter @repo/mobile android",
    "mobile:web": "pnpm --filter @repo/mobile web",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:migrate": "pnpm --filter @repo/api db:migrate",
    "db:seed": "pnpm --filter @repo/api db:seed",
    "db:studio": "pnpm --filter @repo/api db:studio",
    "trpc:generate": "pnpm --filter @repo/api trpc:generate"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  }
}
