# Read by docker compose only. Copy to .env if the defaults clash with something already running.
#
# POSTGRES_VERSION must match whatever the outlet and the managed cloud instance run — the whole
# one-schema design assumes a single Postgres major everywhere.
# POSTGRES_VERSION=18.4

# `cloud` cluster: stands in for the managed server.
# POSTGRES_PORT=5432

# `local` cluster: stands in for the Postgres on the cashier station.
# POSTGRES_LOCAL_PORT=5434
# POSTGRES_LOCAL_DB=pos_d4_local
